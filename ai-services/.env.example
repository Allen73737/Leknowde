# ---------------------------------------------------------------------------
# LeKnowde Intelligence (Python / FastAPI)
# Copy to .env for local development. Never commit real credentials.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=info

# Shared secret the Go API sends as X-Internal-Token. Must match the backend
# AI_INTERNAL_TOKEN. The AI service refuses all analysis calls without it.
INTERNAL_TOKEN=dev-internal-token

# Origins allowed to call the service directly (the browser never should).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Model gateway ---------------------------------------------------------
# Providers are attempted in LLM_PROVIDER_ORDER. Configure at least one.
# Without credentials the deterministic parts (parsing, graphs, impact,
# retrieval, documentation fallback) still work; chat returns HTTP 503 and the
# API surfaces an honest "no model configured" notice.
LLM_PROVIDER_ORDER=litellm,groq,gemini

# Optional LiteLLM proxy (preferred when present)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=groq/llama-3.3-70b-versatile

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.15
LLM_MAX_OUTPUT_TOKENS=1800
CONTEXT_CHAR_BUDGET=48000

# --- Embeddings ------------------------------------------------------------
# lexical = deterministic hashed lexical vectors (no credentials, labelled as
# lexical, not semantic). gemini = real neural embeddings.
EMBEDDING_PROVIDER=lexical
EMBEDDING_MODEL=lexical-hash-v1
EMBEDDING_DIM=256
