# ---------------------------------------------------------------------------
# LeKnowde — environment template
#
# Copy to .env (never commit .env). Every value here is read at runtime.
# Sections are grouped by service.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Backend API (Go)
# ---------------------------------------------------------------------------
LEKNOWDE_ENV=development
PORT=8080

# SQLite (default, zero-dependency) or PostgreSQL:
#   file:./data/leknowde.db
#   postgres://leknowde:leknowde@localhost:5432/leknowde?sslmode=disable
DATABASE_URL=file:./data/leknowde.db

# 32+ characters. Required in production; the server refuses to start with the
# development fallback when LEKNOWDE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# AES-256-GCM key for provider tokens. 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# Python intelligence service
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=dev-internal-token
AI_TIMEOUT_SECONDS=120

# GitHub OAuth app (optional; PAT connections work without it)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/integrations/github/callback

# Limits and workers
LEKNOWDE_DEV_MODE=true
MAX_FILES_PER_REPO=4000
MAX_FILE_BYTES=524288
INDEX_WORKER_COUNT=2
RATE_LIMIT_PER_MINUTE=240
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Intelligence service (Python / FastAPI) — also reads ai-services/.env
# ---------------------------------------------------------------------------
SERVICE_NAME=leknowde-intelligence
INTERNAL_TOKEN=dev-internal-token

# Choose at least one provider for generated answers. Without one, retrieval,
# graphs, health, impact and documentation fallbacks still work.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

LLM_PROVIDER_ORDER=litellm,groq,gemini
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.15
LLM_MAX_OUTPUT_TOKENS=1800
CONTEXT_CHAR_BUDGET=48000

# Embeddings: "lexical" (deterministic, no key) or "gemini"/"litellm".
EMBEDDING_PROVIDER=lexical
EMBEDDING_MODEL=lexical-hash-v1
EMBEDDING_DIM=256

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# Server-side base URL of the Go API. The browser never calls it directly:
# /api/lk/* is proxied through Next.js with the httpOnly session cookie.
LEKNOWDE_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
